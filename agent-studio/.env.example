OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

SAGAD_OCR_ENABLED=true
SAGAD_OCR_LANG=eng
SAGAD_OCR_MAX_PAGES=10
SAGAD_OCR_TIMEOUT_SECONDS=30

LITELLM_ENABLED=false
LITELLM_BASE_URL=http://sagad-litellm:4000/v1
LITELLM_MASTER_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# OpenRouter: set LITELLM_MODEL=openrouter/<provider>/<model> to route through OpenRouter

# LiteLLM aliases in ../infra/litellm/config.example.yaml:
# sagad-openai-fast, sagad-openai-reasoning, sagad-deepseek-chat,
# sagad-openai-embedding. Use OPENAI_BASE_URL=http://sagad-litellm:4000/v1
# only when routing OpenAI-compatible calls through the private gateway.

DATABASE_URL=
AGENT_STUDIO_INTERNAL_SECRET=
SAGAD_INTEGRATION_ENCRYPTION_KEY=
SAGAD_REALTIME_SECRET=

CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_WEBHOOK_TOKEN=

TWENTY_ENABLED=false
TWENTY_BASE_URL=
TWENTY_API_KEY=
TWENTY_API_MODE=graphql
TWENTY_DRY_RUN=true
TWENTY_ALLOW_WRITES=false
TWENTY_TIMEOUT_SECONDS=20

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sagad-agent-studio-dev

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
