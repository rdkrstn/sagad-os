# ===========================================================================
# Model providers (chat + embeddings). See docs/model-providers.md.
# MODEL_PROVIDER selects the chat backend; EMBEDDING_PROVIDER selects embeddings
# (auto = follow MODEL_PROVIDER). Default "none" = zero network, zero credentials
# (DryRun chat + deterministic embeddings) -- the safe open-source default.
# Recommended real providers (all OpenAI-compatible): openrouter / openai / fireworks.
# DeepSeek reuses the openai provider via OPENAI_BASE_URL (see below). Ollama is the
# self-hosted / local-LLM option.
# ===========================================================================
MODEL_PROVIDER=none
EMBEDDING_PROVIDER=auto

# OpenRouter (chat only -- recommended default; one key, many vendors).
# Model is "<vendor>/<model>". No embeddings endpoint -> set EMBEDDING_PROVIDER below.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI (also covers any OpenAI-compatible endpoint via OPENAI_BASE_URL, e.g. DeepSeek).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# DeepSeek (OpenAI-compatible -- reuse the openai provider, no DEEPSEEK_* vars needed):
#   MODEL_PROVIDER=openai
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   OPENAI_MODEL=deepseek-chat
#   (uses OPENAI_API_KEY; DeepSeek has no embeddings -> set EMBEDDING_PROVIDER=fireworks|openai)

# Fireworks AI (OpenAI-compatible at /inference/v1; chat + embeddings from one vendor).
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct
FIREWORKS_EMBEDDING_MODEL=nomic-embed-v1

# LiteLLM gateway (model = alias configured in infra/litellm/config.example.yaml).
# DEEPSEEK_API_KEY is only consumed by the gateway's sagad-deepseek-chat alias.
LITELLM_ENABLED=false
LITELLM_BASE_URL=http://sagad-litellm:4000/v1
LITELLM_MASTER_KEY=
LITELLM_MODEL=
LITELLM_EMBEDDING_MODEL=
DEEPSEEK_API_KEY=

# Ollama Cloud -- self-hosted / local-LLM option. Also covers self-hosted Ollama:
# set OLLAMA_CLOUD_BASE_URL=http://localhost:11434/v1 (or http://host.docker.internal:11434/v1
# in Docker) and leave the API key empty.
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=
OLLAMA_CLOUD_MODEL=llama3.1
OLLAMA_CLOUD_EMBEDDING_MODEL=nomic-embed-text

# Optional: override the embedding vector size for any model.
# EMBEDDING_DIMENSIONS=768
# Per-node model overrides (bare model name for the active provider):
# CLASSIFIER_MODEL=
# GUARDRAIL_MODEL=
# EXTRACTOR_MODEL=
# SUPERVISOR_MODEL=
# Force a deterministic no-LLM graph run (CI / local e2e); takes precedence over MODEL_PROVIDER.
# LLM_MODE=dry_run

# ===========================================================================
# RevOps tiered auto-send "safe lane". A low-risk, high-confidence reply may be
# promoted from needs_review -> pass and auto-sent without a supervisor round-trip.
# When REVOPS_AUTOSEND_INTENTS is unset/empty, the code default ["pricing_lead"] applies
# (the classifier's low-risk pricing intent), so low-risk pricing auto-sends out of
# the box. Override with a comma-list of CLASSIFIER intents. Note these are the only
# intents the classifier emits: pricing_lead / general_support / booking_or_support /
# refund_or_cancellation -- pricing_faq / business_hours / status_check are NOT emitted
# and will never match. Auto-send also requires retrieval_confidence >= the threshold
# (quality_score is capped at min(0.88, retrieval_confidence)); if a low-risk reply
# still queues, enable RERANK_ENABLED or lower REVOPS_AUTOSEND_CONFIDENCE.
# ===========================================================================
REVOPS_AUTOSEND_ENABLED=true
# REVOPS_AUTOSEND_INTENTS=pricing_lead,general_support
REVOPS_AUTOSEND_CONFIDENCE=0.88

# Rerank (improves retrieval_confidence so more low-risk replies clear the auto-send gate).
RERANK_ENABLED=false
RERANK_MODEL=cohere/rerank-english-v3.0
RERANK_API_KEY=

SAGAD_OCR_ENABLED=true
SAGAD_OCR_LANG=eng
SAGAD_OCR_MAX_PAGES=10
SAGAD_OCR_TIMEOUT_SECONDS=30

DATABASE_URL=
AGENT_STUDIO_INTERNAL_SECRET=
SAGAD_INTEGRATION_ENCRYPTION_KEY=
SAGAD_REALTIME_SECRET=

CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_WEBHOOK_TOKEN=

TWENTY_ENABLED=false
TWENTY_BASE_URL=
TWENTY_API_KEY=
TWENTY_API_MODE=graphql
TWENTY_DRY_RUN=true
TWENTY_ALLOW_WRITES=false
TWENTY_TIMEOUT_SECONDS=20

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sagad-agent-studio-dev

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
