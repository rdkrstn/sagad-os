flowchart TD
  Channel["Channel Adapter: Chatwoot / Email / SMS / Voice"] --> Inbound["Canonical Inbound Message"]
  Inbound --> Graph["Agent Studio LangGraph"]
  Graph --> CRM["CRM Adapter: Twenty external / HubSpot / Salesforce / Internal"]
  Graph --> Webhook["Webhook Adapter: Generic Inbound / Outbound"]
  Graph --> KB["Knowledge Adapter: Markdown / Notion / Drive / Confluence"]
  Graph --> Draft["Draft + Tool Plan"]
  Draft --> HITL["Sagad HITL Approval"]
  HITL --> Outbound["Channel Adapter Send"]
  Graph --> Audit["Trace + Audit Adapter"]

  subgraph ProviderSystems["Provider Systems"]
    CRMProvider["CRM / Internal Tool"]
    KBProvider["Knowledge Source"]
    ChannelProvider["Customer Channel"]
    AuditProvider["LangSmith / Audit Store"]
    WebhookProvider["External App / Client System"]
  end

  CRM --> CRMProvider
  Webhook --> WebhookProvider
  KB --> KBProvider
  Outbound --> ChannelProvider
  Audit --> AuditProvider

  classDef adapter fill:#eef6ff,stroke:#2563eb,color:#0f172a;
