  classDef graphNode fill:#f8fafc,stroke:#475569,color:#0f172a;
  classDef approval fill:#fff7ed,stroke:#f97316,color:#0f172a;
  classDef provider fill:#fdf2f8,stroke:#db2777,color:#0f172a;

  class Channel,CRM,Webhook,KB,Outbound,Audit adapter;
  class Inbound,Draft canonical;
  class Graph graphNode;
