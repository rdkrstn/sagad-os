# =====================================================================
# SAGAD OS - CONSOLIDATED ENVIRONMENT VARIABLES FOR DEVELOPMENT
# =====================================================================
# Copy this file to '.env' at the repository root:
#   cp .env.example .env
#
# Both 'v1/' (Next.js frontend) and 'agent-studio/' (Python LangGraph backend)
# will load their configuration from this shared root file.

# ---------------------------------------------------------------------
# CORE SETTINGS & SHARED SECRET CODES
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://sagad:sagad_dev_password@127.0.0.1:5433/sagad_os
AGENT_STUDIO_INTERNAL_SECRET=change-me-for-local-dev
SAGAD_INTEGRATION_ENCRYPTION_KEY=change-me-for-local-dev-32chars!!
SAGAD_REALTIME_SECRET=change-me-for-local-dev

# ---------------------------------------------------------------------
# FRONTEND CONFIG (v1 Next.js Console)
# ---------------------------------------------------------------------
SAGAD_API_BASE_URL=http://127.0.0.1:8010
SAGAD_WS_PUBLIC_URL=ws://127.0.0.1:8010/ws/conversations
AUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-for-local-dev
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=Sagad OS <noreply@sagad.local>

# Optional Google OAuth Client (uncomment/fill to enable Google Sign-in)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------
# BACKEND CONFIG (agent-studio LangGraph Server)
# ---------------------------------------------------------------------
# Model Providers & LLM API Keys
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LiteLLM Private Gateway (Alternative route)
LITELLM_ENABLED=false
LITELLM_BASE_URL=http://sagad-litellm:4000/v1
LITELLM_MASTER_KEY=

# OpenRouter / DeepSeek Alternatives
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# OCR / PDF Ingestion Engine (Tesseract vs IBM Docling)
SAGAD_OCR_ENABLED=true
SAGAD_OCR_LANG=eng
SAGAD_OCR_MAX_PAGES=10
SAGAD_OCR_TIMEOUT_SECONDS=30
SAGAD_DOCLING_ENABLED=true

# Reranker settings (via LiteLLM.rerank)
RERANK_ENABLED=false
RERANK_MODEL=cohere/rerank-english-v3.0
RERANK_API_KEY=

# Chatwoot HITL (Human-In-The-Loop) Integration
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_WEBHOOK_TOKEN=

# Twenty CRM MCP/Adapter Integration
TWENTY_ENABLED=false
TWENTY_BASE_URL=
TWENTY_API_KEY=
TWENTY_API_MODE=graphql
TWENTY_DRY_RUN=true
TWENTY_ALLOW_WRITES=false
TWENTY_TIMEOUT_SECONDS=20

# LangSmith Observability Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sagad-agent-studio-dev

# ---------------------------------------------------------------------
# SENTRY ERROR MONITORING (Shared)
# ---------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
