# Sagad OS self-host/VPS example environment.
#
# Usage:
# 1. Copy this file to `.env` on the server.
# 2. Replace every placeholder secret before starting containers.
# 3. Keep the real `.env` file untracked and private.
#
# Generate strong secrets with one of:
#   openssl rand -base64 32
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------------------------------------------------------------------------
# Sagad Postgres / pgvector
# ---------------------------------------------------------------------------
# Used by Auth.js, the Sagad Console, and Agent Studio persistence.
# In `compose.vps.example.yaml`, the database is internal to Docker and is not
# published to a public host port.
SAGAD_POSTGRES_DB=sagad_os
SAGAD_POSTGRES_USER=sagad
SAGAD_POSTGRES_PASSWORD=replace-with-strong-database-password

# ---------------------------------------------------------------------------
# Console Auth.js
# ---------------------------------------------------------------------------
# AUTH_URL must match the public URL handled by Nginx Proxy Manager.
# AUTH_SECRET signs Auth.js session and verification data. Use a strong random
# value and rotate carefully because changing it invalidates sessions.
# EMAIL_SERVER is required for email magic-link sign-in.
AUTH_URL=https://sagad.example.com
AUTH_SECRET=replace-with-strong-auth-secret
EMAIL_SERVER=smtp://user:password@smtp.example.com:587
EMAIL_FROM="Sagad OS <noreply@example.com>"

# ---------------------------------------------------------------------------
# Console -> Agent Studio trust boundary
# ---------------------------------------------------------------------------
# The console sends this value as an internal header to privileged Agent Studio
# routes. It should be different from AUTH_SECRET and should never be exposed in
# browser code.
AGENT_STUDIO_INTERNAL_SECRET=replace-with-strong-internal-secret

# ---------------------------------------------------------------------------
# Console realtime sync
# ---------------------------------------------------------------------------
# SAGAD_WS_PUBLIC_URL is the browser-reachable Agent Studio WebSocket URL.
# For Nginx Proxy Manager, enable WebSocket support on the proxy host serving
# Agent Studio, then use a public `wss://.../ws/conversations` URL here.
# SAGAD_REALTIME_SECRET is shared by the console and Agent Studio to sign
# short-lived browser realtime tokens. Use a strong random value.
SAGAD_WS_PUBLIC_URL=wss://sagad-agent.example.com/ws/conversations
SAGAD_REALTIME_SECRET=replace-with-strong-realtime-secret

# ---------------------------------------------------------------------------
# Model configuration
# ---------------------------------------------------------------------------
# OPENAI_API_KEY is optional for the deterministic preview paths, but required
# once live model calls or production embeddings are enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Chatwoot channel adapter
# ---------------------------------------------------------------------------
# Chatwoot handles channel intake and approved delivery.
# If Chatwoot is on the same Docker network, the webhook can target:
#   http://sagad-agent-studio:8010/webhooks/chatwoot
# CHATWOOT_WEBHOOK_TOKEN must match the token configured in Chatwoot.
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Twenty CRM adapter
# ---------------------------------------------------------------------------
# Twenty is an external CRM. Browser code must never call Twenty directly.
# Start read-only and dry-run:
#   TWENTY_ENABLED=true
#   TWENTY_DRY_RUN=true
#   TWENTY_ALLOW_WRITES=false
# Enable writes only after HITL approval gates and audit behavior are verified.
TWENTY_ENABLED=false
TWENTY_BASE_URL=
TWENTY_API_KEY=
TWENTY_API_MODE=graphql
TWENTY_DRY_RUN=true
TWENTY_ALLOW_WRITES=false
TWENTY_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# LangSmith observability
# ---------------------------------------------------------------------------
# Optional. Enables traces and run metadata once Agent Studio tracing is wired.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sagad-agent-studio-vps
